# Cloudflare Pages headers.

# ── Canonical domain: baseline security headers for an enterprise docs site ──
https://docs.ferrolabs.ai/*
  X-Robots-Tag: index, follow
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# ── Search results page: crawl-blocked in robots.txt, and noindexed here so
#    external links to it can't put it in the index either ──
/search/*
  X-Robots-Tag: noindex

# ── The 404 page's own URLs serve 200 with a self-canonical — keep them out
#    of the index (real unmatched paths already return HTTP 404) ──
/404
  X-Robots-Tag: noindex
/404/
  X-Robots-Tag: noindex
/404.html
  X-Robots-Tag: noindex

# ── Immutable, content-hashed build assets: cache hard ──
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted variable fonts are byte-stable at a fixed filename — cache for a
# year so repeat visits skip the request entirely.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Vendored, version-named third-party bundles (Scalar API reference) — the
# version is in the filename, so the bytes at a URL never change.
/js/*
  Cache-Control: public, max-age=31536000, immutable

# ── Block the .pages.dev preview subdomain from being indexed ──
https://ferrodocs.pages.dev/*
  X-Robots-Tag: noindex
